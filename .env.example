# ===========================================
# Hopper Shopper Bot — Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_bot_token_here

# --- Database ---
POSTGRES_USER=hopper
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=hopper_shopper
DATABASE_URL=postgresql+asyncpg://hopper:changeme_strong_password@db:5432/hopper_shopper

# --- Ollama LLM (smart classification, parsing & NLU) ---
# Ollama runs alongside the bot for:
#   - Classifying items into supermarket departments
#   - Parsing free-text into structured items (quantity, unit, brand)
#   - Understanding natural language commands ("תוסיף חלב", "קניתי ביצים")
# The model is pulled automatically on first use.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=gemma3:1b
