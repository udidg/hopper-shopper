# ===========================================
# Hopper Shopper - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_bot_token_here

# --- Database ---
POSTGRES_USER=hopper
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=hopper_shopper
DATABASE_URL=postgresql+asyncpg://hopper:changeme_strong_password@db:5432/hopper_shopper

# --- Backend ---
SECRET_KEY=generate_a_random_secret_key_here
CORS_ORIGINS=https://hopper.yourdomain.com
BACKEND_PORT=8000

# --- Frontend ---
VITE_API_BASE_URL=/api
VITE_WS_BASE_URL=/ws

# --- SSL (for Nginx) ---
# Path to SSL certificate and key files (mounted into nginx container)
SSL_CERT_PATH=./nginx/certs/fullchain.pem
SSL_KEY_PATH=./nginx/certs/privkey.pem

# --- Domain ---
DOMAIN=hopper.yourdomain.com
