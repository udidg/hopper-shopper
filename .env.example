# ===========================================
# Hopper Shopper Bot — Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_bot_token_here

# --- Database ---
POSTGRES_USER=hopper
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=hopper_shopper
DATABASE_URL=postgresql+asyncpg://hopper:changeme_strong_password@db:5432/hopper_shopper

# --- Gemini API (primary LLM — cloud, stronger model) ---
# Get a free API key from https://aistudio.google.com/apikey
# When set, Gemini is used as the primary LLM for:
#   - Classifying items into supermarket departments
#   - Parsing free-text into structured items (quantity, unit, brand)
#   - Understanding natural language commands ("תוסיף חלב", "קניתי ביצים")
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Global LLM rate limit ---
# Maximum LLM requests per minute (across all backends).
# Default: 20. Adjust based on your Gemini API quota.
LLM_RATE_LIMIT=20

# --- Ollama LLM (fallback — local, lighter model) ---
# Used as fallback when Gemini is unavailable or rate-limited.
# Ollama runs alongside the bot on the same machine.
# The model is pulled automatically on first use.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=gemma3:1b
