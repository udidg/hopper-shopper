# ===========================================
# Hopper Shopper Bot — Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_bot_token_here

# --- Database ---
POSTGRES_USER=hopper
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=hopper_shopper
DATABASE_URL=postgresql+asyncpg://hopper:changeme_strong_password@db:5432/hopper_shopper

# --- Database Port (host mapping, optional) ---
DB_PORT=5432

# --- Ollama LLM (optional – for smart department classification) ---
# Activate the ollama service with: docker compose --profile llm up
# Then set OLLAMA_URL to enable LLM-based category guessing.
# Leave empty to use keyword-based matching only.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=gemma3:1b
