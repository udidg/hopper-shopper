# ===========================================
# Hopper Shopper – Production Environment
# ===========================================
# Copy this file to .env on your Synology NAS and fill in real values.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_bot_token_here

# --- Database ---
POSTGRES_USER=hopper
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=hopper_shopper
DATABASE_URL=postgresql+asyncpg://hopper:CHANGE_ME_TO_A_STRONG_PASSWORD@db:5432/hopper_shopper

# --- Backend ---
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY
CORS_ORIGINS=https://hopper.udidagan.synology.me

# --- Domain ---
DOMAIN=hopper.udidagan.synology.me
